@startuml
title Deadlock Playground - Class Diagram

top to bottom direction

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam roundcorner 0

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  FontColor #222222
  ArrowColor #444444
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888888
  FontColor #222222
}

package "HTTP and Session Management" {

  class ApiServer {
    + handle HTTP requests
    + validate requests
    + return JSON responses
  }

  class SessionStore {
    + resolve browser session
    + manage session lifecycle
  }
}

package "Simulation Core" {

  class SimulationEngine <<Facade>> {
    + configure(...)
    + request(...)
    + release(...)
    + step()
    + detect()
    + recover(...)
    + reset()
  }

  class Scenario {
    - name: String
    - bankersAvoidance: boolean
  }

  class PreventionToggles {
    - mutualExclusion: boolean
    - holdAndWait: boolean
    - noPreemption: boolean
    - circularWait: boolean
  }

  class Process {
    - id: String
    - priority: int
    - state: ProcessState
    - deadlocked: boolean
  }

  enum ProcessState {
    RUNNING
    WAITING
    COMPLETED
    TERMINATED
  }

  class Resource {
    - name: String
    - totalInstances: int
    - availableInstances: int
    - shareable: boolean
  }

  class Operation {
    - resource: String
    - count: int
  }

  class Graph <<derived view>> {
    + nodes()
    + edges()
    + findCycles()
  }

  class SafetyChecker {
    + check(...): SafetyResult
  }

  class SafetyResult <<value object>>
}

package "Deadlock Detection" {

  interface DetectionStrategy {
    + detect(...): DetectionResult
  }

  class CycleDetection

  class BankersDetection

  class DetectionResult <<value object>>
}

package "Victim Selection" {

  interface VictimPolicy {
    + selectVictim(...): Process
  }

  class PriorityPolicy

  class ResourcesHeldPolicy

  class RecoveryCostPolicy
}

package "Deadlock Recovery" {

  interface RecoveryStrategy

  class Terminate

  class Preempt
}

package "Event History" {

  class History {
    + record(...)
    + navigate(...)
  }

  class HistoryEvent {
    - seq: int
    - type: EventType
    - description: String
  }

  class Snapshot <<restorable state>>
}

' --------------------------------
' API and session relationships
' --------------------------------

ApiServer --> SessionStore : resolves session

ApiServer ..> SimulationEngine : invokes commands

SessionStore --> "0..*" SimulationEngine : isolated engines


' --------------------------------
' Simulation ownership
' --------------------------------

SimulationEngine --> "0..1" Scenario : active scenario

SimulationEngine *-- "1" History : owns history

Scenario *-- "1..*" Process : contains

Scenario *-- "1..*" Resource : contains

Scenario *-- "1" PreventionToggles : configures

Process *-- "0..*" Operation : ordered script

Process --> ProcessState : current state

Process "0..*" -- "0..*" Resource : holds / requests


' --------------------------------
' Graph and avoidance
' --------------------------------

SimulationEngine ..> Graph : derives graph

Graph ..> Process : reads state

Graph ..> Resource : reads state

SimulationEngine ..> SafetyChecker : optional avoidance

SafetyChecker ..> Scenario : reads maximum claims

SafetyChecker ..> Process : reads allocations

SafetyChecker ..> Resource : reads availability

SafetyChecker ..> SafetyResult : produces


' --------------------------------
' Detection Strategy pattern
' --------------------------------

DetectionStrategy <|.. CycleDetection

DetectionStrategy <|.. BankersDetection

SimulationEngine ..> DetectionStrategy : selects and uses

DetectionStrategy ..> DetectionResult : produces

CycleDetection ..> Graph : examines cycles

BankersDetection ..> Process : examines requests

BankersDetection ..> Resource : examines capacity


' --------------------------------
' Victim Policy Strategy pattern
' --------------------------------

VictimPolicy <|.. PriorityPolicy

VictimPolicy <|.. ResourcesHeldPolicy

VictimPolicy <|.. RecoveryCostPolicy

SimulationEngine ..> VictimPolicy : selects eligible victim

VictimPolicy ..> Process : evaluates candidates


' --------------------------------
' Recovery Strategy pattern
' --------------------------------

RecoveryStrategy <|.. Terminate

RecoveryStrategy <|.. Preempt

SimulationEngine ..> RecoveryStrategy : executes recovery

RecoveryStrategy ..> Process : changes execution state

RecoveryStrategy ..> Resource : releases holdings


' --------------------------------
' Event history and snapshots
' --------------------------------

History *-- "0..*" HistoryEvent : records

HistoryEvent "0..*" --> "1" Snapshot : restorable state

Snapshot ..> Process : captures runtime state

Snapshot ..> Resource : captures allocations


note right of SessionStore
  Each browser session has an
  independent simulation engine.

  Sessions are temporary and
  stored in memory.

  No persistent database.
end note

note right of Operation
  Operations represent scripted
  REQUEST and RELEASE actions.

  Requests may involve multiple
  resource instances.
end note

note right of SafetyChecker
  Banker's avoidance is optional.

  Demo mode permits unsafe
  resource allocations.
end note

note bottom of Graph
  Derived from the current
  simulation state.

  Structural cycles and confirmed
  deadlocks are distinct.
end note

note bottom of Snapshot
  Restores execution cursors,
  holdings, pending requests,
  instruction counts and flags.

  History navigation can branch
  after a new committed action.
end note

legend bottom
  |= Relationship |= Meaning |
  | Filled diamond | Composition / ownership |
  | Solid arrow | Association |
  | Dashed arrow | Dependency |
  | Dashed triangle | Interface implementation |
endlegend

@enduml
