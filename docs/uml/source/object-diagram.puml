@startuml
title Deadlock Playground - Object Diagram
caption Example runtime snapshot with resource allocations and pending requests

left to right direction

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 40
skinparam roundcorner 0

skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #444444
  FontColor #222222
}

package "Process Instances" {

  object "P1 : Process" as P1 {
    id = "P1"
    priority = 2
    state = WAITING
    deadlocked = false
  }

  object "P2 : Process" as P2 {
    id = "P2"
    priority = 1
    state = WAITING
    deadlocked = false
  }

  object "P3 : Process" as P3 {
    id = "P3"
    priority = 3
    state = RUNNING
    deadlocked = false
  }
}

package "Resource Instances" {

  object "R1 : Resource" as R1 {
    name = "R1"
    totalInstances = 1
    availableInstances = 0
    shareable = false
  }

  object "R2 : Resource" as R2 {
    name = "R2"
    totalInstances = 2
    availableInstances = 0
    shareable = false
  }

  object "R3 : Resource" as R3 {
    name = "R3"
    totalInstances = 1
    availableInstances = 0
    shareable = false
  }

  object "R4 : Resource" as R4 {
    name = "R4"
    totalInstances = 3
    availableInstances = 3
    shareable = false
  }
}

' --------------------------------
' Current resource allocations
' --------------------------------

P1 -- R2 : holds 1 instance

P2 -- R1 : holds 1 instance

P2 -- R2 : holds 1 instance

P3 -- R3 : holds 1 instance


' --------------------------------
' Pending resource requests
' --------------------------------

P1 -- R1 : waiting for 1 instance

P2 -- R3 : waiting for 1 instance


note bottom of P1
  P1 holds one R2 instance
  and waits for R1.
end note

note bottom of P2
  P2 holds R1 and one R2
  instance while waiting for R3.
end note

note bottom of P3
  P3 holds R3 and remains
  able to execute.
end note

note bottom of R4
  All three instances
  are currently available.
end note

legend bottom
  This object diagram represents one possible
  runtime state, not a confirmed deadlock.

  Resource accounting:

  R1: 1 total, 1 allocated, 0 available
  R2: 2 total, 2 allocated, 0 available
  R3: 1 total, 1 allocated, 0 available
  R4: 3 total, 0 allocated, 3 available

  Links show object relationships.
  Their labels distinguish holdings
  from outstanding resource requests.
endlegend

@enduml
